---
layout: layout.njk
---
<section class="hero">
  <p class="kicker mono">CIS 9000 · IT STRATEGY · PRACTICE CONSOLE</p>
  <h1>Good evening. Ready to practice?</h1>
  <p class="lede">Short weekly question sets that mirror the exam’s case-based reasoning. Miss a question and PAL brings it back on a spaced schedule — that’s the part that makes it stick.</p>
</section>

<section aria-labelledby="missions-h">
  <h2 id="missions-h" class="panel-label mono">MISSION SELECT</h2>
  <ol class="mission-list">
    {% for w in bank.weeks %}
    <li>
      <a class="mission" href="/week-{{ w.week }}/" data-week="{{ w.week }}">
        <span class="mission-num mono">W{{ w.week | pad2 }}</span>
        <span class="mission-title">{{ w.title }}</span>
        <span class="mission-meta mono"><span class="mission-count">{{ w.questions.length }} Q</span><span class="mission-status" data-week-status="{{ w.week }}"></span></span>
      </a>
    </li>
    {% endfor %}
  </ol>
</section>

<section aria-labelledby="review-h" class="review-panel">
  <h2 id="review-h" class="panel-label mono">REVIEW QUEUE</h2>
  <a class="mission mission-review" href="/review/">
    <span class="mission-num mono" aria-hidden="true">RQ</span>
    <span class="mission-title">Review missed questions</span>
    <span class="mission-meta mono" id="review-count">—</span>
  </a>
  <p class="hint">Questions you miss come due again after 1, 3, then 7 days. Clear the queue before it clears you.</p>
</section>

<script type="module" src="/assets/js/home.js"></script>

// PAL 9000 service worker — offline support for subway commutes.
// The full app shell is precached on first visit. Navigations are
// network-first with a short timeout, so fresh weeks always win when online
// and the cache answers the moment a request hangs in a tunnel. Assets are
// stale-while-revalidate. The cache name changes every build: a deploy fully
// replaces the precache on the student's next online visit.
const CACHE = 'pal9000-{{ buildStamp }}';
const NETWORK_TIMEOUT_MS = 3500;
const OFFLINE_URL = '/offline/';

// Precache list. Every entry is a plain URL string (the build test reads them
// straight out of this file); they become Requests at add time.
const SHELL = [
  '/',
{% for w in bank.weeks %}  '/week-{{ w.week }}/',
{% endfor %}  '/review/',
  '/systems/',
  '/offline/',
  '/manifest.webmanifest',
  '/assets/css/style.css',
  '/assets/js/theme.js',
  '/assets/js/engine.js',
  '/assets/js/scheduler.js',
  '/assets/js/storage.js',
  '/assets/js/backup.js',
  '/assets/js/home.js',
  '/assets/js/week-page.js',
  '/assets/js/review-page.js',
  '/assets/js/systems-page.js',
  '/assets/js/sw-register.js',
  '/assets/fonts/michroma-400.woff2',
  '/assets/fonts/ibm-plex-sans-var.woff2',
  '/assets/fonts/ibm-plex-sans-italic-var.woff2',
  '/assets/fonts/ibm-plex-mono-400.woff2',
  '/assets/fonts/ibm-plex-mono-600.woff2',
];

// Nice to have, but never worth failing an install over. Everything else in
// SHELL — every page, the stylesheet, every script, every font — is core:
// if one of those can't be stored, offline mode would be broken in a way the
// student only discovers in a tunnel, so the install fails loudly instead.
const OPTIONAL = new Set([
  '/manifest.webmanifest',
]);

// Add each entry on its own so one bad URL can't reject the whole install the
// way cache.addAll does. `cache: 'reload'` keeps the HTTP cache out of it, so
// a deploy always precaches fresh bytes.
async function precache() {
  const cache = await caches.open(CACHE);
  const failed = await Promise.all(SHELL.map(async (url) => {
    try {
      await cache.add(new Request(url, { cache: 'reload' }));
      return null;
    } catch (err) {
      return url;
    }
  }));
  const missing = failed.filter((url) => url && !OPTIONAL.has(url));
  if (missing.length) {
    throw new Error('PAL 9000: core shell failed to precache — ' + missing.join(', '));
  }
}

self.addEventListener('install', (event) => {
  event.waitUntil(precache().then(() => self.skipWaiting()));
});

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    // Let the browser start the navigation request while this worker boots.
    if (self.registration.navigationPreload) {
      await self.registration.navigationPreload.enable();
    }
    const keys = await caches.keys();
    await Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k)));
    await self.clients.claim();
  })());
});

// Fresh content when the network answers quickly; cache the instant it can't.
// The timeout covers the whole network wait: if navigation preload is in
// flight it races the same clock, and any leftover time carries into fetch().
async function networkFirst(request, cacheKey, preloadResponse) {
  const cache = await caches.open(CACHE);
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), NETWORK_TIMEOUT_MS);
  const expired = new Promise((resolve, reject) => {
    controller.signal.addEventListener('abort', () => reject(new Error('network timeout')));
  });
  expired.catch(() => {}); // the losing side of the race is never awaited
  try {
    let fresh = null;
    if (preloadResponse) fresh = await Promise.race([preloadResponse, expired]);
    if (!fresh) fresh = await fetch(request, { signal: controller.signal });
    clearTimeout(timer);
    if (fresh.ok) cache.put(cacheKey, fresh.clone());
    return fresh;
  } catch (err) {
    clearTimeout(timer);
    const cached = await cache.match(cacheKey);
    if (cached) return cached;
    const offline = await cache.match(OFFLINE_URL);
    if (offline) return offline;
    throw err;
  }
}

// Serve from cache immediately, refresh the cache in the background.
async function staleWhileRevalidate(request) {
  const cache = await caches.open(CACHE);
  const cached = await cache.match(request);
  const refresh = fetch(request)
    .then((res) => {
      if (res.ok) cache.put(request, res.clone());
      return res;
    })
    // Nothing stored and nothing on the wire: answer with a real Response,
    // because respondWith(undefined) throws an opaque network error instead.
    .catch(() => cached || new Response('', { status: 504, statusText: 'offline' }));
  return cached || refresh;
}

self.addEventListener('fetch', (event) => {
  const request = event.request;
  if (request.method !== 'GET') return;
  const url = new URL(request.url);
  if (url.origin !== self.location.origin) return;

  if (request.mode === 'navigate') {
    // Normalize to the precached trailing-slash form and ignore query strings.
    let key = url.pathname;
    if (!key.endsWith('/') && !key.includes('.')) key += '/';
    event.respondWith(networkFirst(request, key, event.preloadResponse));
  } else {
    event.respondWith(staleWhileRevalidate(request));
  }
});

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title %}{{ title }} · {% endif %}PAL 9000</title>
  <meta name="description" content="PAL 9000 — Practice And Learn. Weekly practice questions for CIS 9000: IT Strategy.">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <script src="/assets/js/theme.js"></script>
  <script src="/assets/js/sw-register.js" defer></script>
  <script defer src="https://stats.ianjoshua.com/script.js" data-website-id="c4244f82-9345-4b28-981c-ac5346fd6baf" data-domains="pal9000.netlify.app"></script>
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23FFB000'/><circle cx='50' cy='50' r='16' fill='%23FFDD88'/></svg>">
</head>
<body>
  <header class="site-head">
    <a class="wordmark" href="/">
      <span class="pal-eye" aria-hidden="true"></span>
      <span class="wordmark-text">PAL<span class="wordmark-num">9000</span></span>
    </a>
    <span class="head-status" role="status">ALL CIRCUITS FUNCTIONING</span>
    <button id="theme-toggle" class="theme-toggle mono" type="button">☀ LIGHT</button>
  </header>
  <main class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-foot">
    <p><span class="mono">PAL 9000</span> · Practice And Learn — practice questions for CIS 9000: IT Strategy</p>
    <p class="foot-dim">Your progress is stored only on this device — back it up or clear it in <a href="/systems/">SYSTEMS</a>. Anonymous page counts only — no cookies, nothing personal. Built on the Groundwork pipeline.</p>
  </footer>
</body>
</html>
